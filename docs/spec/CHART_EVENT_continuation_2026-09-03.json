    "bars_15m": 499,
    "bars_4h": 499,
    "source": "top100_klines.json (24h 상승50 + 하락50)"
  },
  "event_definition": {
    "premise": "최근 12봉(3시간) 동안 내 방향으로 >= +1.5% 이동 = 이미 수익 중인 포지션",
    "sampling": "15m 봉 4개마다(1시간) 1회",
    "n_events": {
      "LONG": 1504,
      "SHORT": 1543
    },
    "label": "추가분을 독립 미니 트레이드로 라벨링. 목표 2.0*ATR14 / 손절 1.2*ATR14 / 지평선 32봉(8h). 같은 봉에서 둘 다 닿으면 손절 우선(보수적). 미도달은 32봉 종가 정산.",
    "R_unit": "손절폭(1.2*ATR14) 대비 배수",
    "base": {
      "LONG": {
        "win": 40.0,
        "R": 0.059
      },
      "SHORT": {
        "win": 41.6,
        "R": 0.074
      }
    },
    "lookahead_guard": "판정식은 전부 bar i 까지만. 4H 진행 중 봉은 완료봉 EMA 상태 + 현재 15m 종가로 partial hist 를 재구성한다 (완성된 4H 종가를 그대로 쓰면 미래참조 — 실제로 이 버그가 효과크기 0.47 의 가짜 신호를 만들었다)."
  },
  "validation_gates": [
    "지평선 16/32/64봉 전부 base 초과",
    "홀/짝 심볼 교차검증 — 양쪽 그룹 모두 자기 base 대비 개선",
    "시간 전반/후반 양쪽 개선",
    "심볼 단위 부트스트랩 P(ATR라벨) >= 0.90 & P(고정%라벨) >= 0.75",
    "고정% 라벨과 ATR 라벨 양쪽에서 base 초과",
    "표본 >= 100"
  ],
  "helpers": {
    "sgn": "LONG 이면 +1, SHORT 이면 -1",
    "h4_hist_accel(side)": "4H MACD(12,26,9) hist. 진행 중 봉 hist_p 를 완료봉 EMA 상태 + 현재가로 재구성한 뒤, (hist_p - hist[k])*sgn > (hist[k] - hist[k-1])*sgn. k = 마지막 완료 4H 봉. 「상승 중」이 아니라 「증분이 커지는 중」이다.",
    "pos_in_4h_bar": "(now - 마지막 완료 4H 봉의 close_time) / 4h. 0~1.",
    "rsi14_15m_dir": "LONG 이면 RSI14, SHORT 이면 100-RSI14",
    "atr14_15m_pct_rank(100)": "ATR14 의 최근 100봉 내 자기 순위 0~1 (절대값 금지)",
    "bb_bandwidth_15m_pct_rank(100)": "(upper-lower)/mid 의 최근 100봉 내 자기 순위",
    "obv_slope_norm(tf,k)": "(obv[i]-obv[i-k]) / sum(volume[i-k+1..i])  — 거래량 정규화 필수",
    "consec_4h_candles(side)": "현재 완료 4H 봉부터 거슬러 (close-open)*sgn > 0 인 연속 개수",
    "body_ratio_15m": "|close-open| / (high-low)"
  },
  "add_stage_policy": {
    "question": "1차 추가와 2차 추가의 조건이 달라야 하는가",
    "answer": "그렇다. 방향에 따라 반대로 갈린다.",
    "LONG": "2차 추가가 1차보다 낫다 (base R 1차 +0.040 vs 2차 +0.098). 같은 규칙을 두 번 다 써도 되고, 2차에서 더 세게 나온다.",
    "SHORT": "1차 추가가 2차보다 낫다 (base R 1차 +0.082 vs 2차 +0.049). S_ATR_LO_H4_CONSEC2 는 1차 +0.295 / 2차 +0.076 으로 2차에서 죽는다 = 1차 전용.",
    "both_stages_ok": [
