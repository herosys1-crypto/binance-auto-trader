{
  "spec": "SUPPORT_BOUNCE_VS_BREAKDOWN",
  "version": "1.0",
  "date": "2026-09-03",
  "question": "급락 후 지지선 접촉 시점에서 BOUNCE(반등) 와 BREAKDOWN(추가하락) 을 사전에 가르는 판정식",
  "data_basis": {
    "symbols": 30,
    "symbols_up_24h": 15,
    "symbols_down_24h": 15,
    "timeframes": ["15m", "1h", "4h"],
    "bars_per_tf": 300,
    "events_swing_low": 264,
    "events_resolved_3pct": 220,
    "window_hours_15m": 75,
    "caveat": "표본 264건 / 30심볼 / 15분봉 75시간. 통계적으로 방향은 신뢰할 만하나 절대 승률은 ±5%p 오차를 가정할 것. 하위 분할(n<30) 수치는 참고용."
  },

  "support_definition": {
    "chosen": "swing_low",
    "reason": "9개 정의를 전부 재서 중첩검증(A그룹에서 상위지표 선택 → B그룹에서 재측정) OOS 평균 |d| 가 0.517 로 1위. 표본도 264건으로 최다급.",
    "algorithm": {
      "name": "pivot_low",
      "description": "좌우 3봉보다 낮은 저점(피벗 저점) 중 가장 최근 것. 현재 봉과 직전 3봉은 제외(아직 피벗 확정 불가). 최근 96봉 이내에서만 탐색.",
      "pseudocode": [
        "for j in range(i-4, max(2, i-96), -1):",
        "    if j-3 < 0 or j+3 > i-1: continue",
        "    if low[j] == min(low[j-3 : j+4]): S = low[j]; break"
      ],
      "lookback_bars": 96,
      "pivot_half_width": 3,
      "exclude_recent_bars": 4
    },
    "ranking_measured": [
      {"def": "swing_low",  "n": 264, "oos_mean_abs_d": 0.517, "stable_indicators": 23},
      {"def": "bb_mid",     "n": 266, "oos_mean_abs_d": 0.375, "stable_indicators": 13},
      {"def": "rollmin48",  "n": 144, "oos_mean_abs_d": 0.293, "stable_indicators": 19},
      {"def": "rollmin20",  "n": 224, "oos_mean_abs_d": 0.190, "stable_indicators": 22},
      {"def": "ema50",      "n": 175, "oos_mean_abs_d": 0.178, "stable_indicators": 18},
      {"def": "rollmin96",  "n": 108, "oos_mean_abs_d": 0.129, "stable_indicators": 21},
      {"def": "bb_lower",   "n": 252, "oos_mean_abs_d": -0.125, "stable_indicators": 6},
      {"def": "fib618",     "n": 69,  "oos_mean_abs_d": -0.656, "stable_indicators": 17},
      {"def": "fib50",      "n": 94,  "oos_mean_abs_d": -0.724, "stable_indicators": 12}
    ],
    "rejected": {
      "bb_lower": "볼린저 하단은 접촉이 잦지만(252건) 지표 부호가 두 그룹에서 계속 뒤집힘(OOS -0.125). 「지지선」으로 쓰지 말 것.",
      "fib618_fib50": "표본 69/94건이고 OOS 가 음수(-0.66/-0.72) = 그룹 간 완전 반전. 되돌림 레벨은 이 데이터에서 지지선으로 기능하지 않음.",
      "rollmin20_48_96": "단순 N봉 저점은 접촉 자체가 「이미 신저점」이라 BOUNCE 비율이 43~49% 로 낮음. 판별력도 낮음."
    }
  },

  "touch_detection": {
    "timeframe": "15m",
    "condition_all_of": [
      "low[i] <= S * (1 + tol)",
      "close[i-1] > S * (1 + tol)",
      "(close[i] / max(high[i-24 .. i]) - 1) * 100 <= -1.0"
    ],
    "tol_formula": "max(0.002, 0.25 * ATR14[i] / close[i])",
    "tol_note": "ATR% 중앙값 1.43% 기준 tol 중앙값 ≈ 0.36%",
    "cooldown_bars": 6,
    "evaluate_at": "15분봉 종가 확정 시점"
  },

  "score_rules": {
    "type": "integer_count",
    "max_score": 7,
    "note": "7개 규칙 각 1점. 가중치를 붙여도 결과가 개선되지 않아 등가중을 채택(단순 = 과적합 방어).",
    "rules": [
      {"id": "h1_macdh_pos",     "tf": "1h",  "expr": "macd_hist(12,26,9) > 0",
       "win_yes": 65.5, "win_no": 43.9, "delta_pp": 21.6, "win_yes_A": 73.8, "win_yes_B": 55.8,
       "d_tercile": 0.572, "d_trade": 0.446, "d_A": 0.688, "d_B": 0.211},
      {"id": "h1_above_ema20",   "tf": "1h",  "expr": "close > EMA20",
       "win_yes": 65.4, "win_no": 45.7, "delta_pp": 19.7, "win_yes_A": 69.7, "win_yes_B": 57.9,
       "d_tercile": 0.373, "d_trade": 0.405, "d_A": 0.514, "d_B": 0.223},
      {"id": "m15_macdh_not_rising3", "tf": "15m", "expr": "NOT (macd_hist[i] > macd_hist[i-3])",
       "win_yes": 61.5, "win_no": 42.9, "delta_pp": 18.7, "win_yes_A": 67.6, "win_yes_B": 55.6,
       "d_tercile": -0.380, "d_trade": -0.364, "d_A": -0.437, "d_B": -0.285,
       "warning": "부호가 직관과 반대다. 15분 MACD hist 가 3봉 상승 중이면 그 접촉은 더 잘 깨진다. 아래꼬리/RSI 반등과 달리 이 지표는 진입가 통제 후에도 살아남았다(층별 d -0.40/-0.49, 지지선 지정가 가정에서도 -0.298)."},
      {"id": "m15_rsi24_ge_45",  "tf": "15m", "expr": "RSI(24) >= 45",
       "win_yes": 62.7, "win_no": 46.1, "delta_pp": 16.6, "win_yes_A": 66.7, "win_yes_B": 56.5,
       "d_tercile": 0.246, "d_trade": 0.356, "d_A": 0.412, "d_B": 0.224},
      {"id": "h1_rsi12_ge_50",   "tf": "1h",  "expr": "RSI(12) >= 50",
       "win_yes": 64.7, "win_no": 46.6, "delta_pp": 18.1, "win_yes_A": 68.8, "win_yes_B": 57.9,
       "d_tercile": 0.394, "d_trade": 0.345, "d_A": 0.445, "d_B": 0.185},
      {"id": "m15_drop96_ge_m15","tf": "15m", "expr": "(close / max(high[i-96..i]) - 1) * 100 >= -15.0",
       "win_yes": 61.6, "win_no": 41.9, "delta_pp": 19.8, "win_yes_A": 67.1, "win_yes_B": 56.2,
       "d_tercile": 0.565, "d_trade": 0.328, "d_A": 0.188, "d_B": 0.337,
       "meaning": "24시간 고점에서 15% 넘게 빠진 자리는 지지선이 잘 깨진다. BOUNCE 평균 -11.2% vs BREAKDOWN 평균 -19.1%."},
      {"id": "m15_above_ema50",  "tf": "15m", "expr": "close > EMA50",
       "win_yes": 67.7, "win_no": 50.0, "delta_pp": 17.7, "win_yes_A": 70.3, "win_yes_B": 64.0,
       "d_tercile": 0.182, "d_trade": 0.325, "d_A": 0.302, "d_B": 0.294}
    ]
  },

